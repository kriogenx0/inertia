#!/bin/bash
# Fast test suite run automatically before every commit (installed via
# `make hooks`, wired into `.git/hooks/pre-commit`). This is a short/cheap
# gate, not the full suite: backend runs only test/models + test/controllers
# (skips slower tiers like test/system or test/integration if those show up
# later), and frontend just runs jest. Run `make test` by hand for the full
# suite before pushing.
set -e
cd "$(git rev-parse --show-toplevel)"
make test-fast
