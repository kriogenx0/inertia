FROM node:22-slim

ARG HTTP_PROXY
ARG HTTPS_PROXY
ARG NO_PROXY
ENV HTTP_PROXY=$HTTP_PROXY \
    HTTPS_PROXY=$HTTPS_PROXY \
    NO_PROXY=$NO_PROXY \
    http_proxy=$HTTP_PROXY \
    https_proxy=$HTTPS_PROXY \
    no_proxy=$NO_PROXY

WORKDIR /app

COPY package.json package-lock.json* ./
# postinstall (scripts/brand-electron-dev.sh) needs to exist before `npm
# install` runs it — everything else stays after, for layer caching.
COPY scripts ./scripts
RUN npm install

COPY . .

EXPOSE 5174
CMD ["npm", "run", "dev"]
