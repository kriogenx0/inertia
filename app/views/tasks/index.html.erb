<h1>Listing tasks</h1>

<table>
  <tr>
    <th>Username</th>
    <th>Name</th>
    <th>Description</th>
    <th>Eta</th>
    <th>Parent</th>
    <th>Status</th>
    <th></th>
    <th></th>
    <th></th>
  </tr>

<% @users.each do |user| %>
<% user.tasks.each do |task| %>
  <tr>
    <td><%= user.name %></td>
    <td><%= task.name %></td>
    <td><%= task.description %></td>
    <td><%= task.eta %></td>
    <td><%= task.parent %></td>
    <td><%= task.status %></td>
    <td><%= link_to 'Show', task %></td>
    <td><%= link_to 'Edit', edit_task_path(task) %></td>
    <td><%= link_to 'Destroy', task, confirm: 'Are you sure?', method: :delete %></td>
  </tr>
<% end %>
<% end %>
</table>

<br />

<%= link_to 'New Task', new_task_path %>
