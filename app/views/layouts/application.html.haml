!!! 5
%html(lang="en-US")
  %head
    = csrf_meta_tag
    %title Inertia
    
    = stylesheet_link_tag "jandi-reset.css"
    = stylesheet_link_tag "jandi-ui.css"
    = stylesheet_link_tag "http://fonts.googleapis.com/css?family=Lobster"
    
    = stylesheet_link_tag "ui/ui.css"
    = stylesheet_link_tag "themes/theme.css"
    = stylesheet_link_tag "content/content.css"
    
    = javascript_include_tag :defaults
    -#/* CK EDITOR
    -#= stylesheet_link_tag "/libraries"
    -#= javascript_include_tag "/libraries/ckeditor/ckeditor.js"

  %body
    .header
      .layout-width
        .left
          %a.logo
            Inertia
        .right
          .userControl.topTab
            .bg-left
              .bg-right
                .bg-mid
                  Alex V |
                  = link_to 'Sign Out', 'javascript: void(0)'
          .nav
            %a SEO
            %a Users
        .clear
    .content
      .layout-width.content-inner
        = yield
    .footer

